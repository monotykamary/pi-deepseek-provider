{
  "name": "pi-deepseek-provider",
  "version": "3.0.8",
  "description": "DeepSeek provider extension for pi - V4 Pro, V4 Flash & Reasoner with 1M context and thinking mode",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit && node scripts/test-pi-compat.mjs",
    "update-models": "node scripts/update-models.js",
    "test:pi": "node scripts/test-pi-compat.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "extension",
    "provider",
    "deepseek",
    "deepseek-ai",
    "ai",
    "llm",
    "deepseek-v4",
    "deepseek-reasoner"
  ],
  "author": "",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "@earendil-works/pi-coding-agent": "1.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
